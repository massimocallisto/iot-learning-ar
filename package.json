{
  "name": "configuratore-tesi-react",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4200",
    "start": "vite --host 0.0.0.0 --port 4200",
    "_start:https:local": "ng serve --host 0.0.0.0 --port 4200 --ssl --ssl-cert ssl/localhost+2.pem --ssl-key ssl/localhost+2-key.pem",
    "start:https:local": "cross-env HTTPS_KEY_PATH=ssl/localhost+2-key.pem HTTPS_CERT_PATH=ssl/localhost+2.pem vite --host 0.0.0.0 --port 4200",
    "backend": "node backend/server.js",
    "_backend:https:local": "cross-env HTTPS_KEY_PATH=ssl/localhost+2-key.pem HTTPS_CERT_PATH=ssl/localhost+2.pem HTTPS_ONLY=true node backend/server.js",
    "backend:https:local": "HTTPS_KEY_PATH=ssl/localhost+2-key.pem HTTPS_CERT_PATH=ssl/localhost+2.pem HTTPS_ONLY=true node backend/server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4200"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "bootstrap": "^5.3.8",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "vite": "^6.0.7"
  }
}
